# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See DEPLOY.md for the full VPS runbook this file supports.

# --- Postgres ---
POSTGRES_USER=rcd
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rcd_corp
# Local dev: 127.0.0.1 (loopback only). Production: 0.0.0.0 (public interface;
# combine with the ufw allowlist rules in DEPLOY.md — do not expose without them).
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# --- SQL Server ---
MSSQL_SA_PASSWORD=Change-Me-Strong-P@ssw0rd
# Local dev default is 14330 (avoids clashing with a native SQL Server install
# on Windows dev machines). Production: use 0.0.0.0 / 1433 (again, only with
# the ufw allowlist in place).
SQLSERVER_BIND=127.0.0.1
SQLSERVER_PORT=14330

# --- Generator ---
GEN_PROFILE=demo
GEN_SEED=42

# --- Streaming (prod overlay only) ---
STREAM_ROWS_PER_TICK=25
STREAM_INTERVAL=300

# --- Nginx / TLS (prod overlay only) ---
# Domain pointed at the VPS's public IP, used for the Let's Encrypt cert.
# Leave blank and follow the self-signed instructions in DEPLOY.md if you
# don't have one.
DOMAIN=

# --- Firewall allowlist (documentation only — applied manually via ufw,
# see DEPLOY.md; not read by docker compose) ---
ADMIN_IPS=203.0.113.10,203.0.113.11
