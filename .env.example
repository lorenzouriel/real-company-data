# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See DEPLOY.md for the full home-lab (Tailscale) runbook this file supports.

# --- Postgres ---
POSTGRES_USER=rcd
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rcd_corp
# Local dev: 127.0.0.1 (loopback only, nothing else can reach it).
# Home-lab/remote access: your Tailscale IP (`tailscale ip -4` on the server),
# e.g. 100.101.102.103 — binds the port to the tailnet interface only, so it's
# reachable from your other Tailscale devices but never the LAN or internet.
# Never set this to 0.0.0.0 unless you have a firewall in front of it that
# you've verified — see DEPLOY.md.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# --- SQL Server ---
MSSQL_SA_PASSWORD=Change-Me-Strong-P@ssw0rd
# Local dev default is 14330 (avoids clashing with a native SQL Server install
# on Windows dev machines). On a Linux host without that conflict, 1433 is
# fine. Same POSTGRES_BIND guidance above applies here.
SQLSERVER_BIND=127.0.0.1
SQLSERVER_PORT=14330

# --- Generator ---
GEN_PROFILE=demo
GEN_SEED=42

# --- Streaming ---
STREAM_ROWS_PER_TICK=25
STREAM_INTERVAL=300
