# Copy this file to infra/nginx/rcd-data.conf and replace YOUR_DOMAIN before
# starting the nginx service. See DEPLOY.md for the full TLS setup (Let's
# Encrypt via certbot, or the self-signed fallback if you have no domain).

server {
    listen 80;
    server_name YOUR_DOMAIN;

    # Let's Encrypt HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name YOUR_DOMAIN;

    # --- Let's Encrypt (default) ---
    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    # --- No domain? Comment the two lines above and uncomment these instead,
    #     after generating a self-signed cert per DEPLOY.md ---
    # ssl_certificate     /etc/letsencrypt/live/selfsigned/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/selfsigned/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;

    location = / {
        return 302 /output/;
    }

    location /output/ {
        alias /usr/share/nginx/output/;
        autoindex on;
        auth_basic "RCD Corp Data";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }
}
